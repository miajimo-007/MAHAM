{
  "name": "maham",
  "version": "2026.11.07.2",
  "private": true,
  "description": "MAHAM — team work-tracking and performance app, and its analysis Lab, each delivered as one HTML file.",
  "author": "Mohammed Miaji",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "python3 tools/build.py",
    "test": "python3 tests/run_all.py",
    "build:lab": "python3 lab/tools/build.py",
    "test:lab": "python3 lab/tests/test_lab.py",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"*.{md,json}\" \"docs/**/*.md\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"*.{md,json}\" \"docs/**/*.md\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.1"
  }
}
